<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?colorPrimary"
        app:strokeColor="@android:color/transparent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="?dialogPreferredPadding">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="24dp"
                android:layout_centerVertical="true"
                android:tint="?colorOnPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/status_icon"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?colorOnPrimary"
                android:textSize="18sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/status_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/status_text"
                android:layout_alignStart="@id/status_text"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?colorOnPrimary"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/status_api"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/status_version"
                android:layout_alignStart="@id/status_version"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?colorOnPrimary"
                android:textSize="12sp" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/update_card"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?colorSecondaryContainer">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="?dialogPreferredPadding">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/update_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_update_24dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/update_icon"
                android:text="@string/update_title"
                android:textAppearance="?textAppearanceTitleMedium"
                android:textColor="?colorOnSecondaryContainer"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/update_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/update_title"
                android:layout_alignStart="@id/update_title"
                android:layout_marginTop="3dp"
                android:text="@string/update_summary"
                android:textAppearance="?textAppearanceTitleMedium"
                android:textColor="?colorOnSecondaryContainer"
                android:textSize="12sp" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        app:dividerThickness="1dp"
        app:dividerInsetStart="36dp"
        app:dividerInsetEnd="36dp" />

    <com.google.android.material.search.SearchBar
        android:id="@+id/search_anchor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="8dp"
        android:hint="@string/feature_search_hint" />

</LinearLayout>